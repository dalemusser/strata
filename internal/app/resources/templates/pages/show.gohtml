{{/* pages/show - Display a page */}}
{{ define "pages/show" }}
{{ template "layout" . }}
{{ end }}

{{ define "content" }}
<div class="max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold mb-6">{{ .Title }}</h1>
    <div class="prose dark:prose-invert max-w-none">
        {{ if .Content }}
        {{ .Content }}
        {{ else }}
        <p class="text-gray-500 dark:text-gray-400">No content yet.</p>
        {{ end }}
    </div>
</div>
{{ end }}
