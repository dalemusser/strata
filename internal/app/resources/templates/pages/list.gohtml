{{/* pages/list - List editable pages */}}
{{ define "pages/list" }}
{{ template "layout" . }}
{{ end }}

{{ define "content" }}
<div class="max-w-2xl mx-auto">
    <h1 class="text-3xl font-bold mb-6">Manage Pages</h1>

    <div class="bg-white dark:bg-gray-800 rounded-lg shadow overflow-hidden">
        <ul class="divide-y divide-gray-200 dark:divide-gray-600">
            {{ range .Pages }}
            <li>
                <a href="/admin/pages/{{ . }}/edit" class="block px-6 py-4 hover:bg-gray-50 dark:hover:bg-gray-700 flex justify-between items-center">
                    <span class="capitalize">{{ . }}</span>
                    <span class="text-blue-600">Edit</span>
                </a>
            </li>
            {{ end }}
        </ul>
    </div>
</div>
{{ end }}
