{{/* pages/edit - Edit a page */}}
{{ define "pages/edit" }}
{{ template "layout" . }}
{{ end }}

{{ define "content" }}
<div class="max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold mb-6">Edit Page: {{ .Slug }}</h1>

    {{ if .Success }}
    <div class="bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-200 p-3 rounded mb-4">Page saved successfully!</div>
    {{ end }}
    {{ if .Error }}
    <div class="bg-red-100 dark:bg-red-900 text-red-700 dark:text-red-200 p-3 rounded mb-4">{{ .Error }}</div>
    {{ end }}

    <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow">
        <form method="POST" action="/admin/pages/{{ .Slug }}" class="space-y-4">
            <div>
                <label for="title" class="block text-sm font-medium mb-1">Title</label>
                <input type="text" id="title" name="title" value="{{ .Title }}" required
                    class="w-full px-3 py-2 border rounded dark:bg-gray-700 dark:border-gray-600">
            </div>
            <div>
                <label for="content" class="block text-sm font-medium mb-1">Content</label>
                <textarea id="content" name="content" rows="15"
                    class="w-full px-3 py-2 border rounded dark:bg-gray-700 dark:border-gray-600 font-mono">{{ .Content }}</textarea>
                <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">HTML content for this page</p>
            </div>
            <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Save Page</button>
        </form>
    </div>

    <p class="mt-4"><a href="/admin/pages" class="text-blue-600 hover:underline">Back to Pages</a></p>
</div>
{{ end }}
