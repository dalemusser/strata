{{/* profile/change_password - Change password form */}}
{{ define "profile/change_password" }}
{{ template "layout" . }}
{{ end }}

{{ define "content" }}
<div class="max-w-md mx-auto">
    <h1 class="text-3xl font-bold mb-6">Change Password</h1>

    {{ if .Required }}
    <div class="bg-yellow-100 dark:bg-yellow-900 text-yellow-700 dark:text-yellow-200 p-3 rounded mb-4">
        You must change your temporary password before continuing.
    </div>
    {{ end }}
    {{ if .Error }}
    <div class="bg-red-100 dark:bg-red-900 text-red-700 dark:text-red-200 p-3 rounded mb-4">{{ .Error }}</div>
    {{ end }}

    <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow">
        <form method="POST" class="space-y-4">
            {{ if not .Required }}
            <div>
                <label for="current_password" class="block text-sm font-medium mb-1">Current Password</label>
                <input type="password" id="current_password" name="current_password" required
                    class="w-full px-3 py-2 border rounded dark:bg-gray-700 dark:border-gray-600">
            </div>
            {{ end }}
            <div>
                <label for="new_password" class="block text-sm font-medium mb-1">New Password</label>
                <input type="password" id="new_password" name="new_password" required minlength="8"
                    class="w-full px-3 py-2 border rounded dark:bg-gray-700 dark:border-gray-600">
            </div>
            <div>
                <label for="confirm_password" class="block text-sm font-medium mb-1">Confirm New Password</label>
                <input type="password" id="confirm_password" name="confirm_password" required minlength="8"
                    class="w-full px-3 py-2 border rounded dark:bg-gray-700 dark:border-gray-600">
            </div>
            <button type="submit" class="w-full bg-blue-600 text-white py-3 rounded hover:bg-blue-700">Change Password</button>
        </form>
    </div>

    <p class="mt-4 text-center"><a href="/profile" class="text-blue-600 hover:underline">Back to Profile</a></p>
</div>
{{ end }}
