{{/* dashboard/admin - Admin dashboard */}}
{{ define "dashboard/admin" }}
{{ template "layout" . }}
{{ end }}

{{ define "content" }}
<div>
    <h1 class="text-3xl font-bold mb-6">Admin Dashboard</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-8">Welcome back, {{ .UserName }}!</p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/system-users" class="block bg-white dark:bg-gray-800 p-6 rounded-lg shadow hover:shadow-lg transition-shadow">
            <h2 class="text-xl font-semibold mb-2">System Users</h2>
            <p class="text-gray-600 dark:text-gray-400">Manage admin users</p>
        </a>
        <a href="/audit-log" class="block bg-white dark:bg-gray-800 p-6 rounded-lg shadow hover:shadow-lg transition-shadow">
            <h2 class="text-xl font-semibold mb-2">Audit Log</h2>
            <p class="text-gray-600 dark:text-gray-400">View system activity</p>
        </a>
        <a href="/settings" class="block bg-white dark:bg-gray-800 p-6 rounded-lg shadow hover:shadow-lg transition-shadow">
            <h2 class="text-xl font-semibold mb-2">Settings</h2>
            <p class="text-gray-600 dark:text-gray-400">Configure site settings</p>
        </a>
        <a href="/admin/pages" class="block bg-white dark:bg-gray-800 p-6 rounded-lg shadow hover:shadow-lg transition-shadow">
            <h2 class="text-xl font-semibold mb-2">Pages</h2>
            <p class="text-gray-600 dark:text-gray-400">Edit site pages</p>
        </a>
        <a href="/profile" class="block bg-white dark:bg-gray-800 p-6 rounded-lg shadow hover:shadow-lg transition-shadow">
            <h2 class="text-xl font-semibold mb-2">Profile</h2>
            <p class="text-gray-600 dark:text-gray-400">Manage your profile</p>
        </a>
    </div>
</div>
{{ end }}
