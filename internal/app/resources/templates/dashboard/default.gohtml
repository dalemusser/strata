{{/* dashboard/default - Default dashboard */}}
{{ define "dashboard/default" }}
{{ template "layout" . }}
{{ end }}

{{ define "content" }}
<div>
    <h1 class="text-3xl font-bold mb-6">Dashboard</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-8">Welcome back, {{ .UserName }}!</p>

    <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow">
        <p>Your dashboard is ready. Add your content here.</p>
    </div>
</div>
{{ end }}
