{{/* systemusers/show - View user details */}}
{{ define "systemusers/show" }}
{{ template "layout" . }}
{{ end }}

{{ define "content" }}
<div class="max-w-2xl mx-auto">
    <h1 class="text-3xl font-bold mb-6">{{ .User.FullName }}</h1>

    <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow">
        <dl class="space-y-4">
            <div>
                <dt class="text-sm text-gray-500 dark:text-gray-400">Login ID</dt>
                <dd class="text-lg">{{ if .User.LoginID }}{{ .User.LoginID }}{{ else }}-{{ end }}</dd>
            </div>
            <div>
                <dt class="text-sm text-gray-500 dark:text-gray-400">Email</dt>
                <dd class="text-lg">{{ if .User.Email }}{{ .User.Email }}{{ else }}-{{ end }}</dd>
            </div>
            <div>
                <dt class="text-sm text-gray-500 dark:text-gray-400">Role</dt>
                <dd class="text-lg">{{ .User.Role }}</dd>
            </div>
            <div>
                <dt class="text-sm text-gray-500 dark:text-gray-400">Status</dt>
                <dd class="text-lg">{{ .User.Status }}</dd>
            </div>
            <div>
                <dt class="text-sm text-gray-500 dark:text-gray-400">Auth Method</dt>
                <dd class="text-lg">{{ .User.AuthMethod }}</dd>
            </div>
        </dl>
    </div>

    <div class="mt-4 space-x-4">
        <a href="/system-users/{{ .User.ID.Hex }}/edit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 inline-block">Edit</a>
        <a href="/system-users" class="text-blue-600 hover:underline">Back to Users</a>
    </div>
</div>
{{ end }}
