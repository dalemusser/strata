{{/* systemusers/list - User list */}}
{{ define "systemusers/list" }}
{{ template "layout" . }}
{{ end }}

{{ define "content" }}
<div>
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold">System Users</h1>
        <a href="/system-users/new" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Add User</a>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-lg shadow overflow-hidden">
        <table class="w-full">
            <thead class="bg-gray-50 dark:bg-gray-700">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Name</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Login ID</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Role</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-600">
                {{ range .Users }}
                <tr>
                    <td class="px-6 py-4 whitespace-nowrap">{{ .FullName }}</td>
                    <td class="px-6 py-4 whitespace-nowrap">{{ if .LoginID }}{{ .LoginID }}{{ end }}</td>
                    <td class="px-6 py-4 whitespace-nowrap">{{ .Role }}</td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        {{ if eq .Status "active" }}
                        <span class="px-2 py-1 text-xs bg-green-100 text-green-800 rounded">Active</span>
                        {{ else }}
                        <span class="px-2 py-1 text-xs bg-red-100 text-red-800 rounded">Disabled</span>
                        {{ end }}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <a href="/system-users/{{ .ID.Hex }}/edit" class="text-blue-600 hover:underline">Edit</a>
                    </td>
                </tr>
                {{ end }}
            </tbody>
        </table>
    </div>
</div>
{{ end }}
