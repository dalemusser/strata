{{/* home/index - Home page */}}
{{ define "home/index" }}
{{ template "layout" . }}
{{ end }}

{{ define "content" }}
<div class="text-center">
    <h1 class="text-4xl font-bold mb-4">Welcome to {{ .SiteName }}</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-8">Your application is ready to go.</p>
    {{ if not .IsLoggedIn }}
    <a href="/login" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700">Get Started</a>
    {{ else }}
    <a href="/dashboard" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700">Go to Dashboard</a>
    {{ end }}
</div>
{{ end }}
