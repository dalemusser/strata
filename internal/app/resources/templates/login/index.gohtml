{{/* login/index - Login method selection */}}
{{ define "login/index" }}
{{ template "layout" . }}
{{ end }}

{{ define "content" }}
<div class="max-w-md mx-auto bg-white dark:bg-gray-800 rounded-lg shadow p-8">
    <h1 class="text-2xl font-bold mb-6 text-center">Login</h1>

    {{ if .Error }}
    <div class="bg-red-100 dark:bg-red-900 text-red-700 dark:text-red-200 p-3 rounded mb-4">{{ .Error }}</div>
    {{ end }}

    <div class="space-y-4">
        <a href="/login/password" class="block w-full text-center bg-blue-600 text-white py-3 rounded hover:bg-blue-700">
            Login with Password
        </a>
        <a href="/login/email" class="block w-full text-center bg-green-600 text-white py-3 rounded hover:bg-green-700">
            Login with Email
        </a>
        {{ if .GoogleEnabled }}
        <a href="/auth/google" class="block w-full text-center bg-red-600 text-white py-3 rounded hover:bg-red-700">
            Login with Google
        </a>
        {{ end }}
        <a href="/login/trust" class="block w-full text-center bg-gray-600 text-white py-3 rounded hover:bg-gray-700">
            Trust Login (Dev)
        </a>
    </div>
</div>
{{ end }}
