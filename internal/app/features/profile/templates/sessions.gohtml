{{ define "profile/sessions" }}
  {{ template "layout" . }}
{{ end }}

{{ define "content" }}
<div class="flex flex-col h-full">
<div class="mb-4 flex items-center">
  <a href="/profile"
     class="text-sm px-3 py-1 border dark:border-gray-600 rounded hover:bg-gray-50 dark:hover:bg-gray-700 mr-2 no-loader"
     title="Go back">
    ← Back
  </a>
  <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Active Sessions</h1>
</div>

<div class="p-4 bg-white dark:bg-gray-800 rounded shadow text-gray-700 dark:text-gray-300 text-sm flex-1 mb-2">
  {{ if .Success }}
    <div class="bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 p-2 rounded mb-4">
      {{ .Success }}
    </div>
  {{ end }}

  {{ if .Error }}
    <div class="bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 p-2 rounded mb-4">
      {{ .Error }}
    </div>
  {{ end }}

  <p class="mb-4 text-gray-600 dark:text-gray-400">
    These are the devices currently logged into your account. You can revoke access for any session.
  </p>

  {{ if .Sessions }}
    <div class="space-y-3 mb-6">
      {{ range .Sessions }}
        <div class="border dark:border-gray-700 rounded p-3 {{ if .IsCurrent }}bg-indigo-50 dark:bg-indigo-900/20 border-indigo-200 dark:border-indigo-800{{ end }}">
          <div class="flex justify-between items-start">
            <div>
              <div class="font-semibold flex items-center gap-2">
                {{ .Device }}
                {{ if .IsCurrent }}
                  <span class="text-xs bg-indigo-100 dark:bg-indigo-900 text-indigo-700 dark:text-indigo-300 px-2 py-0.5 rounded">Current Session</span>
                {{ end }}
              </div>
              <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                {{ if .IPAddress }}IP: {{ .IPAddress }}{{ end }}
              </div>
              <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                Last active: {{ .LastActivity.Format "Jan 2, 2006 at 3:04 PM" }}
              </div>
            </div>
            {{ if not .IsCurrent }}
              <form method="POST" action="/profile/sessions/{{ .ID }}/revoke">
                <button type="submit"
                        class="text-sm text-red-600 dark:text-red-400 hover:underline"
                        onclick="return confirm('Revoke this session? The device will be logged out.');">
                  Revoke
                </button>
              </form>
            {{ end }}
          </div>
        </div>
      {{ end }}
    </div>
  {{ else }}
    <p class="text-gray-500 dark:text-gray-400 py-4 text-center mb-6">
      No active sessions found.
    </p>
  {{ end }}

  {{ if gt (len .Sessions) 1 }}
    <div class="border-t dark:border-gray-700 pt-4">
      <form method="POST" action="/profile/sessions/revoke-all">
        <button type="submit"
                class="px-4 py-2 bg-red-600 text-white rounded text-sm hover:bg-red-700"
                onclick="return confirm('Log out all other sessions? You will remain logged in on this device.');">
          Log Out All Other Sessions
        </button>
      </form>
    </div>
  {{ end }}
</div>
</div>
{{ end }}
